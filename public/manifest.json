{
  "id": "splendid-chat-pwa",
  "name": "SPLENDID CHAT",
  "short_name": "SplendidChat",
  "description": "A modern messaging app with Firebase phone & passcode authentication, mirror glass aesthetics, real-time push notifications, voice notes, and media attachments.",
  "start_url": "https://splendidchat.vercel.app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#121418",
  "theme_color": "#dc2626",
  "categories": [
    "social",
    "messaging",
    "productivity"
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  },
  "widgets": [
    {
      "name": "Unread Messages",
      "short_name": "Unread",
      "description": "Keep track of unread direct messages in real-time.",
      "tag": "unread-chats",
      "template": "unread_widget",
      "ms_ac_template": "/widgets/unread.json",
      "data": "/widgets/unread-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/icon.svg",
          "sizes": "512x512",
          "type": "image/svg+xml"
        }
      ]
    }
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "type": "image/svg+xml",
      "sizes": "192x192 512x512",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Direct Messages",
      "short_name": "Messages",
      "description": "Open active chat conversations",
      "url": "/?view=chats",
      "icons": [
        {
          "src": "/icon.svg",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Profile Settings",
      "short_name": "Settings",
      "description": "Customize your account profile and theme",
      "url": "/?view=settings",
      "icons": [
        {
          "src": "/icon.svg",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "lang": "en"
}
