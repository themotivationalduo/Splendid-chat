{
  "entities": {
    "users": {
      "title": "Users",
      "description": "Registered user accounts indexed by phone number and user ID",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "username": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "normalizedPhone": { "type": "string" },
        "avatar": { "type": "string" },
        "avatarType": { "type": "string" },
        "bio": { "type": "string" },
        "status": { "type": "string" },
        "lastSeen": { "type": "string" },
        "pinCode": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "fullName", "username", "phoneNumber", "normalizedPhone"]
    },
    "chats": {
      "title": "Chats",
      "description": "Chat conversations between users or groups",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "avatar": { "type": "string" },
        "avatarType": { "type": "string" },
        "isGroup": { "type": "boolean" },
        "groupMembers": { "type": "array", "items": { "type": "string" } },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "participantPhones": { "type": "array", "items": { "type": "string" } },
        "lastMessageText": { "type": "string" },
        "lastMessageTime": { "type": "string" },
        "lastMessageSenderId": { "type": "string" },
        "lastMessageType": { "type": "string" },
        "pinned": { "type": "boolean" },
        "muted": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "participantIds"]
    },
    "messages": {
      "title": "Messages",
      "description": "Messages inside chat rooms",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "number" },
        "type": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaName": { "type": "string" },
        "mediaSize": { "type": "string" },
        "audioDuration": { "type": "number" },
        "audioWaveform": { "type": "array", "items": { "type": "number" } },
        "expiresAt": { "type": "number" },
        "isExpired": { "type": "boolean" },
        "isForwarded": { "type": "boolean" },
        "forwardedFrom": { "type": "string" },
        "isRead": { "type": "boolean" },
        "readBy": { "type": "array", "items": { "type": "string" } },
        "reactions": { "type": "object" },
        "replyToId": { "type": "string" }
      },
      "required": ["id", "chatId", "senderId", "createdAt"]
    },
    "callLogs": {
      "title": "Call Logs",
      "description": "Real call history and records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "callerId": { "type": "string" },
        "receiverId": { "type": "string" },
        "contactName": { "type": "string" },
        "contactPhone": { "type": "string" },
        "contactAvatar": { "type": "string" },
        "type": { "type": "string" },
        "callType": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "number" },
        "duration": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "callerId", "receiverId", "type", "createdAt"]
    },
    "calls": {
      "title": "Calls",
      "description": "Real-time call signaling channel documents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "callerId": { "type": "string" },
        "callerName": { "type": "string" },
        "callerAvatar": { "type": "string" },
        "receiverId": { "type": "string" },
        "isVideo": { "type": "boolean" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "callerId", "receiverId", "status", "createdAt"]
    },
    "statuses": {
      "title": "Statuses",
      "description": "User status posts that expire after 24 hours",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "userFullName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "string" },
        "duration": { "type": "number" },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" }
      },
      "required": ["id", "userId", "type", "content", "createdAt", "expiresAt"]
    },
    "broadcast_feeds": {
      "title": "Broadcast Feeds",
      "description": "Feed channels created by users to broadcast updates to participants",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "avatar": { "type": "string" },
        "description": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "creatorAvatar": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "avatar", "creatorId", "createdAt"]
    },
    "broadcast_feed_posts": {
      "title": "Broadcast Feed Posts",
      "description": "Individual update posts within a specific broadcast channel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "feedId": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "creatorAvatar": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "string" },
        "duration": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "feedId", "creatorId", "type", "content", "createdAt"]
    }
  }
}
